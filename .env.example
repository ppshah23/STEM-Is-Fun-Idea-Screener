# Get this from https://console.anthropic.com/, or run `ant auth login` and
# leave this unset (see README). Not required if MOCK_MODE=1 below.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# When 1, the pipeline never calls Claude -- run_skill returns randomized
# placeholder data shaped like the real output_schema instead. Free to run,
# useful for exercising the UI/scoring, not useful for real screening.
MOCK_MODE=1
