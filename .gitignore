# Python
__pycache__/
*.pyc
.venv/
venv/

# Environment / secrets
.env
.env.*
!.env.example

# Node / Next.js (web/ also carries its own .gitignore; this is a repo-root safety net)
node_modules/
.next/
out/
*.tsbuildinfo
.vercel

# Generated pipeline output (ideas/roadmaps/levels/reviews) - keep folders, not contents
output/ideas/*
!output/ideas/.gitkeep
output/levels/*
!output/levels/.gitkeep
output/reviews/*
!output/reviews/.gitkeep
output/roadmaps/*
!output/roadmaps/.gitkeep

